# One multimodal model for planning, grounding, replanning and stop verification.
# Copy to .env in this package root; fill in all three required values.
MODEL_API_KEY=your-api-key
MODEL_BASE_URL=https://your-endpoint.example/v1
MODEL_NAME=your-multimodal-model

# Provider token-budget field; unknown-parameter responses trigger bounded repair.
# MODEL_TOKEN_PARAMETER=max_tokens
# MODEL_TOKEN_PARAMETER=max_completion_tokens

# Optional Qwen thinking control, applied consistently to every model request.
# MODEL_ENABLE_THINKING=1

# Bounding-box convention. Probe new models with tools/probe_bbox_real.py.
# MODEL_BBOX_SCALE=1000
# MODEL_BBOX_SCALE=pixel
